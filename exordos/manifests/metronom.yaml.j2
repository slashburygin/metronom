# The metronome web app, served as static files from the realm core load
# balancer. The path a request takes:
#
#   browser -> <realm>.exordos.com:443
#           -> the installation's shared ingress LB (nginx on its core host)
#                TLS terminates here, on the installation's own certificate
#                server_name = the realm domain
#                location / -> upstream(<realm node>:80)
#           -> nginx on the realm node, which is the realm core's own LB
#                server_name _ -- the ingress does not forward the original
#                  Host header, so only the catch-all vhost ever matches
#                location /api/core/ -> the realm API, untouched
#                location /          -> the route below
#
# Hence the shape of this element: it adds one route to the vhost the core
# already runs, and creates no LB, DNS record or certificate of its own. It
# claims the `/` prefix of that vhost, so it cannot share a realm with another
# element serving `/`.
#
# The element owns everything it runs under: the organization, the project, the
# owner user and that user's password, which the platform generates on install.

name: "metronom"
description: "Browser metronome served from the realm core load balancer"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

imports:
  # The catch-all HTTP vhost of the core LB -- the one the installation's
  # ingress proxies the realm traffic into
  core_http_vhost:
    element: "$core"
    kind: "resource"
    link: "$core.network.lb.$core_lb.vhosts.$core_lb_core_http"

requirements:
  core:
    from_version: "0.0.0"

resources:
  $metronom.imports.$core_http_vhost.routes:
    metronom_route:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      parent: $metronom.imports.$core_http_vhost:uuid
      condition:
        kind: prefix
        value: /
        actions:
          # The agent on the LB downloads this archive and unpacks it into
          # /var/www/gc_downloaded/<uuid5 of the vhost and condition>/, which
          # nginx then serves with `alias`. It re-downloads whenever the URL
          # changes -- which is why the element version is part of it.
          - kind: local_dir_download
            url: "{{ repository | default('https://repo.exordos.com/exordos-elements') }}/metronom/{{ version }}/artifacts/site.tar.zst"
